<odoo>

    <record id="rule_public_available_books"
            model="ir.rule">

        <field name="name">
            Public users only available books
        </field>

        <field name="model_id"
               ref="model_library_book"/>

        <field name="groups"
               eval="[(4, ref('library_management.group_library_public'))]"/>

        <field name="domain_force">
            [('available', '=', True)]
        </field>

    </record>

</odoo>